pragma language_version >= 0.22.0;

import "@midnight-ntwrk/compact-stdlib";

// ─────────────────────────────────────────────────────────────────────────────
// ConfidentialEscrow — production-ready private escrow for agent-to-agent work
//
// Privacy model:
//   - Escrow amounts: private
//   - Party identities: protected by commitment
//   - Task details: private (only hash is stored)
//   - Status (0-4): public getter for indexing
//   - Nullifiers: prevent double-spend and double-completion
//
// Lifecycle:
//   create_escrow → fund_escrow → submit_completion → release_escrow
//                                                   → dispute_escrow → resolve_dispute
//                               → cancel_escrow (before funding)
// ─────────────────────────────────────────────────────────────────────────────

contract ConfidentialEscrow {

    pub const arbiter: Address;   // dispute resolver (e.g. DAO or multisig)

    private escrows:   Map<Bytes, EscrowRecord>;
    private nullifiers: Map<Bytes, Bool>;   // prevent replays

    struct EscrowRecord {
        creator:      Address,
        counterparty: Address,
        amount:       U64,
        task_hash:    Bytes,    // SHA-256 of off-chain task spec
        status:       U8,       // 0=created 1=funded 2=submitted 3=released 4=disputed 5=cancelled
        creator_commitment:      Bytes,
        counterparty_commitment: Bytes
    }

    pub fn new(arbiter_address: Address) {
        arbiter = arbiter_address;
    }

    // ── Creator operations ────────────────────────────────────────────────────

    // Create a private escrow — locks creator's commitment to task + amount
    pub circuit fn create_escrow(
        escrow_id:              Bytes,
        counterparty:           Address,
        amount:                 U64,
        task_hash:              Bytes,
        creator_commitment:     Bytes,
        counterparty_commitment: Bytes
    ) -> bool {
        assert(!nullifiers.member(escrow_id), "Escrow ID already used");
        assert(msg_sender_commitment() == creator_commitment, "Unauthorized creator");

        nullifiers.insert(escrow_id, true);
        escrows.insert(escrow_id, EscrowRecord {
            creator:     msg_sender(),
            counterparty,
            amount,
            task_hash,
            status: 0,
            creator_commitment,
            counterparty_commitment
        });
        true
    }

    // Cancel escrow before counterparty funds (status=0 only)
    pub circuit fn cancel_escrow(escrow_id: Bytes, commitment: Bytes) -> bool {
        assert(msg_sender_commitment() == commitment, "Unauthorized");
        let e = escrows.get(escrow_id);
        assert(e.status == 0, "Can only cancel unfunded escrow");
        assert(e.creator_commitment == commitment, "Only creator can cancel");
        escrows.update(escrow_id, fun(r) => r.status = 5);
        true
    }

    // ── Counterparty operations ───────────────────────────────────────────────

    // Counterparty accepts and funds the escrow
    pub circuit fn fund_escrow(escrow_id: Bytes, commitment: Bytes) -> bool {
        assert(msg_sender_commitment() == commitment, "Unauthorized counterparty");
        let e = escrows.get(escrow_id);
        assert(e.status == 0, "Escrow not in created state");
        assert(e.counterparty_commitment == commitment, "Wrong counterparty");
        escrows.update(escrow_id, fun(r) => r.status = 1);
        true
    }

    // Counterparty submits proof of task completion
    pub circuit fn submit_completion(
        escrow_id:  Bytes,
        commitment: Bytes,
        proof_hash: Bytes   // hash of off-chain completion evidence
    ) -> bool {
        assert(msg_sender_commitment() == commitment, "Unauthorized counterparty");
        let e = escrows.get(escrow_id);
        assert(e.status == 1, "Escrow not funded");
        assert(e.counterparty_commitment == commitment, "Wrong counterparty");
        escrows.update(escrow_id, fun(r) => r.status = 2);
        // proof_hash stored off-chain or in event — not stored on-chain for privacy
        true
    }

    // ── Creator release / dispute ─────────────────────────────────────────────

    // Creator releases funds after reviewing completion
    pub circuit fn release_escrow(escrow_id: Bytes, commitment: Bytes) -> bool {
        assert(msg_sender_commitment() == commitment, "Unauthorized creator");
        let e = escrows.get(escrow_id);
        assert(e.status == 2, "Completion not submitted");
        assert(e.creator_commitment == commitment, "Only creator can release");
        escrows.update(escrow_id, fun(r) => r.status = 3);
        true
    }

    // Creator raises dispute if work is unsatisfactory
    pub circuit fn dispute_escrow(escrow_id: Bytes, commitment: Bytes) -> bool {
        assert(msg_sender_commitment() == commitment, "Unauthorized creator");
        let e = escrows.get(escrow_id);
        assert(e.status == 2, "Completion not submitted");
        assert(e.creator_commitment == commitment, "Only creator can dispute");
        escrows.update(escrow_id, fun(r) => r.status = 4);
        true
    }

    // ── Arbiter resolution ────────────────────────────────────────────────────

    // Arbiter resolves dispute: release_to_counterparty or refund_to_creator
    pub circuit fn resolve_dispute(
        escrow_id:            Bytes,
        release_to_counterparty: Bool
    ) -> bool {
        assert(msg_sender() == arbiter, "Only arbiter can resolve");
        let e = escrows.get(escrow_id);
        assert(e.status == 4, "No active dispute");
        // 3 = released, 5 = cancelled (refunded)
        let new_status: U8 = release_to_counterparty ? 3 : 5;
        escrows.update(escrow_id, fun(r) => r.status = new_status);
        true
    }

    // ── ZK Proofs ─────────────────────────────────────────────────────────────

    // Prove escrow amount is above threshold (for reputation/credential systems)
    pub circuit fn prove_escrow_amount_above(escrow_id: Bytes, threshold: U64) -> bool {
        let e = escrows.get(escrow_id);
        assert(e.amount >= threshold, "Escrow below threshold");
        true
    }

    // ── Public Getters ────────────────────────────────────────────────────────

    pub fn get_status(escrow_id: Bytes) -> U8 {
        escrows.get(escrow_id).status
    }

    pub fn get_arbiter() -> Address {
        arbiter
    }
}
